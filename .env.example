# ============================================================
# Gemini API 配置
# ============================================================
# Google Gemini 官方 API Key（必须通过环境变量提供，切勿提交至代码仓库）
GEMINI_API_KEY=

# 默认使用的模型（默认使用 gemini-3.8-flash，各用户亦可通过指令自由切换）
GEMINI_MODEL=gemini-3.8-flash

# 默认思考深度配置 (Gemini 3 系列: MINIMAL, LOW, MEDIUM, HIGH，默认 LOW 保持流畅快速回复)
DEFAULT_THINKING_LEVEL=LOW

# 默认每次对话携带的历史消息条数（默认4条，即2轮之前的对话）
DEFAULT_CONTEXT_MESSAGES=4

# 单次生成的最大 token 数量
MAX_OUTPUT_TOKENS=2048

# 是否默认启用 Google Search Grounding 实时搜索 (true / false)
ENABLE_SEARCH_DEFAULT=true

# API 请求超时时间（秒）
GEMINI_TIMEOUT_SECONDS=45

# API 失败最大重试次数（使用指数退避）
GEMINI_MAX_RETRIES=3

# ============================================================
# 动态会话与智能上下文压缩配置
# ============================================================
# 连续对话超时阈值（秒，默认 600 秒 = 10分钟；10分钟内的连续互动视为同一连贯会话，完整保留上下文）
SESSION_TIMEOUT_SECONDS=600

# 触发自动压缩的安全轮数上限（默认 10 轮 = 20 条未压缩消息，超出时自动调用 gemini-3.5-flash-lite 提炼摘要）
SESSION_COMPRESSION_THRESHOLD_ROUNDS=10

# 触发压缩后保留最近的原汁原味对话轮数（默认 4 轮 = 8 条消息，更早的对话将提炼为高密度背景摘要）
SESSION_KEEP_RECENT_ROUNDS=4

# ============================================================
# QQ / OneBot 11 适配器配置
# ============================================================
# 允许使用机器人的 QQ 号白名单（逗号分隔，仅白名单内的用户能触发回复）
# 示例：QQ_WHITELIST=12345678,87654321
QQ_WHITELIST=

# OneBot 适配器运行模式:
# "reverse_ws": 本程序作为 WebSocket 服务端，NapCat/OneBot 作为客户端主动连接（推荐，免公网IP）
# "forward_ws": 本程序作为客户端，主动连接 NapCat/OneBot 的 WebSocket 服务端
ONEBOT_MODE=reverse_ws

# 反向 WebSocket 监听主机与端口（仅限本机或受信任内网）
REVERSE_WS_HOST=127.0.0.1
REVERSE_WS_PORT=8080
REVERSE_WS_PATH=/onebot/v11/ws

# 正向 WebSocket 目标地址（当 ONEBOT_MODE=forward_ws 时生效）
FORWARD_WS_URL=ws://127.0.0.1:3001

# OneBot 通信访问令牌（可选，若 NapCat 配置了 access_token，请在此填入）
ONEBOT_ACCESS_TOKEN=

# ============================================================
# 系统与性能控制
# ============================================================
# 全局调用 Gemini API 的最大并发数限制（默认不超过 2，防止触发限频）
MAX_GEMINI_CONCURRENCY=2

# 单个用户消息处理超时时间（秒）
USER_REQUEST_TIMEOUT=60

# SQLite 数据库存储文件路径
SQLITE_DB_PATH=data/assistant.db

# 日志级别 (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# 指令响应防检测随机抖动（秒，默认 3.0~6.0 秒，模拟真人打字/思考反应，降低被腾讯封控概率）
COMMAND_JITTER_MIN_SECONDS=3.0
COMMAND_JITTER_MAX_SECONDS=6.0
